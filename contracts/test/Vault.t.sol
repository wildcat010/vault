pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {console} from "forge-std/console.sol";

import {VTK} from "../src/VTK.sol";
import {Vault} from "../src/Vault.sol";

import {Vm} from "forge-std/Vm.sol";

import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {ERC1967Proxy} from "@openzeppelin/contracts/proxy/ERC1967/ERC1967Proxy.sol";

contract VaultTest is Test {
    VTK public vtk;
    Vault public vault;

    address public owner = address(1);
    address public alice = address(2);

    function setUp() public {
        vtk = new VTK();

        Vault implementation = new Vault();

        bytes memory data = abi.encodeCall(
            Vault.initialize,
            (IERC20(address(vtk)), owner)
        );

        ERC1967Proxy proxy = new ERC1967Proxy(address(implementation), data);

        vault = Vault(address(proxy));
    }

    function test_Initialization() public view {
        assertEq(address(vault.asset()), address(vtk));
        assertEq(vault.owner(), owner);
        assertEq(vault.name(), "Vault Tokenized Share");
        assertEq(vault.symbol(), "vVTK");
    }

    function test_CannotInitializeTwice() public {
        vm.expectRevert();

        vault.initialize(IERC20(address(vtk)), owner);
    }

    function test_Deposit() public {
        uint256 amount = 100 ether;

        vm.deal(alice, amount);

        vm.prank(alice);
        vtk.buyVTK{value: amount}();

        vm.prank(alice);
        vtk.approve(address(vault), amount);

        vm.prank(alice);
        uint256 shares = vault.deposit(amount, alice);

        assertEq(alice.balance, 0);
        assertEq(vtk.balanceOf(alice), 0);
        assertEq(vault.balanceOf(alice), shares);
        assertEq(vault.balanceOf(alice), amount);
        assertEq(vault.totalAssets(), amount);
    }

    function test_DepositTrackingAndEvent() public {
        uint256 amount = 100 ether;

        vm.deal(alice, amount);

        vm.prank(alice);
        vtk.buyVTK{value: amount}();

        vm.prank(alice);
        vtk.approve(address(vault), amount);

        // Record logs generated by the deposit
        vm.recordLogs();

        vm.prank(alice);
        vault.deposit(amount, alice);

        Vm.Log[] memory entries = vm.getRecordedLogs();

        // Identify the custom event
        bytes32 eventSignature = keccak256(
            "DepositRecorded(address,uint256,uint256,uint256)"
        );

        // Display only DepositRecorded
        for (uint256 i = 0; i < entries.length; i++) {
            if (
                entries[i].emitter == address(vault) &&
                entries[i].topics[0] == eventSignature
            ) {
                address receiver = address(
                    uint160(uint256(entries[i].topics[1]))
                );

                (uint256 assets, uint256 shares, uint256 timestamp) = abi
                    .decode(entries[i].data, (uint256, uint256, uint256));

                console.log("----- DepositRecorded Event -----");
                console.log("Receiver:", receiver);
                console.log("Assets:", assets);
                console.log("Shares:", shares);
                console.log("Timestamp:", timestamp);
            }
        }

        // Verify the deposit mapping
        (uint256 recordedAmount, uint256 lastAccrualTime) = vault.accounts(
            alice
        );

        assertEq(recordedAmount, amount);
        assertEq(lastAccrualTime, block.timestamp);

        // Verify Alice's shares
        assertEq(vault.balanceOf(alice), amount);
    }

    function test_InterestAfterOneYear() public {
        uint256 amount = 100 ether;

        vm.deal(alice, amount);

        vm.prank(alice);
        vtk.buyVTK{value: amount}();

        vm.prank(alice);
        vtk.approve(address(vault), amount);

        // Alice deposits 100 VTK.
        vm.prank(alice);
        vault.deposit(amount, alice);

        // Move forward exactly one year.
        vm.warp(block.timestamp + 365 days);

        // Trigger interest calculation with a zero-value deposit.
        vm.prank(alice);
        vault.deposit(0, alice);

        (uint256 balance, ) = vault.accounts(alice);

        // 100 VTK + 3% interest = 103 VTK.
        assertEq(balance, 103 ether);
    }

    function test_InterestWithSecondDepositAfterSixMonths() public {
        uint256 amount = 100 ether;

        vm.deal(alice, 2 * amount);

        vm.prank(alice);
        vtk.buyVTK{value: 2 * amount}();

        vm.prank(alice);
        vtk.approve(address(vault), 2 * amount);

        // First deposit: 100 VTK.
        vm.prank(alice);
        vault.deposit(amount, alice);

        // Move forward six months.
        vm.warp(block.timestamp + 365 days / 2);

        // Second deposit: another 100 VTK.
        vm.prank(alice);
        vault.deposit(amount, alice);

        // Move forward another six months.
        vm.warp(block.timestamp + 365 days / 2);

        // Trigger interest calculation.
        vm.prank(alice);
        vault.deposit(0, alice);

        (uint256 balance, ) = vault.accounts(alice);

        // First deposit: 100 + 1.5% = 101.5 VTK 365/2.
        // Second deposit: 101.5 + 100 + 1.5% = 101.5 VTK 365/2.
        assertEq(balance, 204.5225 ether);
    }

    function test_MonthlyDepositsForOneYear() public {
        uint256 monthlyAmount = 50 ether;

        vm.deal(alice, 12 * monthlyAmount);

        vm.prank(alice);
        vtk.buyVTK{value: 12 * monthlyAmount}();

        vm.prank(alice);
        vtk.approve(address(vault), 12 * monthlyAmount);

        // Deposit 50 VTK every month for 12 months.
        for (uint256 i = 0; i < 12; i++) {
            vm.prank(alice);
            vault.deposit(monthlyAmount, alice);

            // Move forward one month.
            vm.warp(block.timestamp + 365 days / 12);
        }

        // Trigger interest calculation after the final month.
        vm.prank(alice);
        vault.deposit(0, alice);

        (uint256 balance, ) = vault.accounts(alice);

        console.log("Final account balance:", balance / 1 ether);

        // Verify the final balance.
        assertGt(balance, 600 ether);
    }

    function test_Withdrawal() public {
        uint256 amount = 100 ether;

        vm.deal(alice, amount);

        vm.prank(alice);
        vtk.buyVTK{value: amount}();

        vm.prank(alice);
        vtk.approve(address(vault), amount);

        vm.prank(alice);
        vault.deposit(amount, alice);

        // Alice withdraws VTK from the Vault.
        vm.prank(alice);
        uint256 withdrawnAmount = vault.withdraw(amount, alice, alice);

        assertEq(vault.balanceOf(alice), 0);
        assertEq(vault.totalAssets(), 0);
        assertEq(vtk.balanceOf(alice), amount);

        // Alice sells VTK back for ETH.
        vm.prank(alice);
        vtk.sellVTK(withdrawnAmount);

        assertEq(alice.balance, amount);
        assertEq(vtk.balanceOf(alice), 0);
        assertEq(vault.balanceOf(alice), 0);
    }

    function test_RevertWhenWithdrawMoreThanBalance() public {
        uint256 amount = 100 ether;

        vm.deal(alice, amount);

        vm.prank(alice);
        vtk.buyVTK{value: amount}();

        vm.prank(alice);
        vtk.approve(address(vault), amount);

        vm.prank(alice);
        vault.deposit(amount, alice);

        assertEq(vault.balanceOf(alice), amount);
        assertEq(vault.totalAssets(), amount);
        assertEq(vtk.balanceOf(alice), 0);

        vm.expectRevert();
        vm.prank(alice);
        vault.withdraw(101 ether, alice, alice);

        assertEq(vault.balanceOf(alice), amount);
        assertEq(vault.totalAssets(), amount);
        assertEq(vtk.balanceOf(alice), 0);
    }
}
